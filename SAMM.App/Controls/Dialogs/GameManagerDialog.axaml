<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:advconv="clr-namespace:ADVTheme.Converters;assembly=ADVTheme"
             x:Class="SAMM.App.Controls.Dialogs.GameManagerDialog">
	<UserControl.Resources>
		<advconv:DoubleIncrementConverter x:Key="TitleSizing" ModifierMethod="Add" ModifierValue="6"/>
	</UserControl.Resources>
	<Border Background="{DynamicResource ADVTheme.Brush.Background.Base}" BorderBrush="{DynamicResource ADVTheme.Brush.Border.Base}" BorderThickness="2" CornerRadius="{DynamicResource ADVTheme.CornerRadius}">
		<Grid Margin="5" RowDefinitions="Auto,*,50">
			
		</Grid>
	</Border>
</UserControl>
